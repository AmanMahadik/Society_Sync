{
  "name": "societysync-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade Turborepo & pnpm workspace for SocietySync",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "prettier": "^3.3.3",
    "typescript": "^5.3.3",
    "rimraf": "^5.0.5"
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=18.0.0"
  }
}
